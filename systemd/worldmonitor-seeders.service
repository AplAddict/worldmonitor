[Unit]
Description=Refresh self-hosted World Monitor source caches
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=25min
User=root
Group=root
WorkingDirectory=/srv/appdata/worldmonitor
ExecStart=/srv/appdata/worldmonitor/scripts/run-seeders-systemd.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/srv/appdata/worldmonitor
