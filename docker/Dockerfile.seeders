# The executable project tree is mounted read-only from the existing deployment;
# no source image build is needed for a scheduled refresh.
FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
RUN apk add --no-cache coreutils
WORKDIR /app
ENTRYPOINT ["node", "/runner/start-seeders.mjs"]
