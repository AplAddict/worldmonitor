FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
WORKDIR /app
COPY docker/credential-service.mjs ./credential-service.mjs
COPY docker/provider-catalog.mjs ./provider-catalog.mjs
RUN chmod 0644 ./credential-service.mjs ./provider-catalog.mjs
# Docker secrets are root-owned (0400); this narrowly scoped service must read its
# sync token. Its only exposed routes require Authentik-forwarded identity and a
# same-origin request, and it never returns secret values.
USER root
EXPOSE 8090
CMD ["node", "/app/credential-service.mjs"]
